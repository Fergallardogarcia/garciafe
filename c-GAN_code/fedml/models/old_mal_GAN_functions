            #     for param in params
            # ]
            # optimizer.step()

            # Step 2: optimize with fake loss.
           
            optimizer.zero_grad()
            input_znoises = torch.randn(labels.size(0), latent_size).to(device)
            fake_data = gen_model(input_znoises, labels).detach()
            fake_outputs = model(fake_data)
